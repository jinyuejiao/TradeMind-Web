# 复制为 .env 后填写（勿提交真实密码到仓库）

# 静态页服务（如 python -m http.server 9013 指向 TradeMind-Web 根目录）
TM_WEB_BASE=http://localhost:9013

# API 网关
TM_API_BASE=http://localhost:8080

# 主管理员（批发 WHOLESALE）
TM_ADMIN_USER=jin
TM_ADMIN_PASSWORD=123456

# 或使用其他账号
# TM_ADMIN_USER=admin_test
# TM_ADMIN_PASSWORD=your_md5_or_plain_per_env

# 若后端要求 MD5(plain)，设为 true 时 fixture 会对密码做 MD5
TM_PASSWORD_IS_MD5=false

# 只读子账号（角色 READONLY，用于 X-22 / D-16 等）
TM_READONLY_USER=readonly_test
TM_READONLY_PASSWORD=

# 第二租户（隔离用例 X-10）
TM_TENANT_B_USER=
TM_TENANT_B_PASSWORD=
